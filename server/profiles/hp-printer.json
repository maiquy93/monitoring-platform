{
  "id": "hp-printer",
  "name": "Máy in HP (LaserJet / PageWide / OfficeJet)",
  "description": "Chuẩn RFC 3805 (Printer-MIB), RFC 2790 (Host Resources) và HP LaserJet MIB (1.3.6.1.4.1.11.2.3.9). Theo dõi lượng mực còn lại (toner), độ bền drum, tổng số trang đã in và trạng thái phần cứng.",
  "priority": 10,
  "match": [
    { "sysObjectID": ["1.3.6.1.4.1.11.2.3.9"] },
    { "sysDescr": "(laserjet|pagewide|officejet|designjet|hp.*printer)" }
  ],
  "extends": "generic",
  "verified_with": [],
  "metrics": {
    "cpu": null,
    "ram": null,
    "disk": null,
    "toner": {
      "label": "Mực in (thấp nhất)",
      "unit": "%",
      "optional": true,
      "sources": [
        {
          "table": {
            "columns": { "level": "1.3.6.1.2.1.43.11.1.1.9", "max": "1.3.6.1.2.1.43.11.1.1.8", "type": "1.3.6.1.2.1.43.11.1.1.5" },
            "where": { "type": ["3", "5", "6", "19"] },
            "value": { "percent": { "used": "level", "total": "max" } },
            "agg": "min"
          },
          "unverified": true
        },
        {
          "table": {
            "columns": { "level": "1.3.6.1.2.1.43.11.1.1.9", "max": "1.3.6.1.2.1.43.11.1.1.8", "descr": "1.3.6.1.2.1.43.11.1.1.6" },
            "where_match": { "descr": "toner|cartridge|black|cyan|magenta|yellow" },
            "value": { "percent": { "used": "level", "total": "max" } },
            "agg": "min"
          },
          "unverified": true
        },
        {
          "table": {
            "columns": { "level": "1.3.6.1.2.1.43.11.1.1.9", "max": "1.3.6.1.2.1.43.11.1.1.8" },
            "value": { "percent": { "used": "level", "total": "max" } },
            "agg": "min"
          },
          "unverified": true
        }
      ]
    },
    "drum": {
      "label": "Độ bền Drum (thấp nhất)",
      "unit": "%",
      "optional": true,
      "sources": [
        {
          "table": {
            "columns": { "level": "1.3.6.1.2.1.43.11.1.1.9", "max": "1.3.6.1.2.1.43.11.1.1.8", "type": "1.3.6.1.2.1.43.11.1.1.5" },
            "where": { "type": ["9"] },
            "value": { "percent": { "used": "level", "total": "max" } },
            "agg": "min"
          },
          "unverified": true
        },
        {
          "table": {
            "columns": { "level": "1.3.6.1.2.1.43.11.1.1.9", "max": "1.3.6.1.2.1.43.11.1.1.8", "descr": "1.3.6.1.2.1.43.11.1.1.6" },
            "where_match": { "descr": "drum|image.*drum|imaging.*unit|opc|trống" },
            "value": { "percent": { "used": "level", "total": "max" } },
            "agg": "min"
          },
          "unverified": true
        }
      ]
    },
    "page_count": {
      "label": "Tổng số trang đã in",
      "unit": " trang",
      "optional": true,
      "sources": [
        { "get": "1.3.6.1.2.1.43.10.2.1.4.1.1", "unverified": true },
        { "get": "1.3.6.1.4.1.11.2.3.9.4.2.1.4.1.2.5.0", "unverified": true }
      ]
    }
  }
}
